rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the calling user's role from their users doc
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && userRole() == 'admin';
    }

    function isTechOrAdmin() {
      return request.auth != null && userRole() in ['tech', 'admin'];
    }

    // ── Buildings ──────────────────────────────────────────────────────────────
    // Public can read the building list; only admins can write.
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if isAdmin();

      // Secure subcollection: tech and admin can read, only admin can write.
      match /secure/{doc} {
        allow read: if isTechOrAdmin();
        allow write: if isAdmin();
      }
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Users can read ONLY themselves.
      // Admins can read everybody.
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin());

      // User can create their own profile document.
      allow create: if request.auth != null &&
                      request.auth.uid == userId;

      // Users can update their own profile
      // BUT cannot change their role.
      // Admins can update any user except themselves.
      allow update: if request.auth != null &&
                      (
                        (
                          request.auth.uid == userId &&
                          request.resource.data.role == resource.data.role
                        )
                        ||
                        (isAdmin() && request.auth.uid != userId)
                      );

      // Optional: only admins can delete users.
      allow delete: if isAdmin();
    }

  }
}