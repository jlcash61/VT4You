rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the calling user's role from their users doc
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && userRole() == 'admin';
    }

    function isTechOrAdmin() {
      return request.auth != null && userRole() in ['tech', 'admin'];
    }

    // ── Buildings ──────────────────────────────────────────────────────────────
    // Public can read the building list; only admins can write.
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if isAdmin();

      // Secure subcollection: tech and admin can read, only admin can write.
      match /secure/{doc} {
        allow read: if isTechOrAdmin();
        allow write: if isAdmin();
      }
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    // Any authenticated user can read their own doc (needed for role lookup).
    // Admins can read all user docs (needed for the admin panel).
    // Admins can write any user doc EXCEPT their own (prevents self-demotion).
    match /users/{userId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && request.auth.uid != userId;
    }

  }
}